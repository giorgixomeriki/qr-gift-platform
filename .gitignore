# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Visual-QA raw captures (regenerable). Curated review sheets are committed
# as .webp beside a README.md; raw screenshots, recordings and exports stay local.
/docs/visual-walkthrough/**/*.png
/docs/visual-walkthrough/**/*.jpg
/docs/visual-walkthrough/**/*.webm
/docs/visual-walkthrough/**/*.pdf
/docs/visual-walkthrough/**/*.csv
/docs/visual-walkthrough/index.html
/docs/visual-walkthrough/manifest.json
# Local review exports
/docs 2/
/*.zip
